{
  "name": "zero-after-midnight",
  "private": true,
  "version": "0.1.0",
  "description": "零点之后：都市悬疑现代 ADV",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "node ../../packages/cli/dist/index.js lint .",
    "simulate": "node ../../packages/cli/dist/index.js simulate . --max-paths 500 --max-steps 20000",
    "audio:audit": "node scripts/audio-audit.mjs --json",
    "audio:normalize": "node scripts/audio-audit.mjs --normalize --target-rms-dbfs -23 --max-peak-dbfs -1",
    "test": "node scripts/verify-simulation.mjs && vitest run test/player-ui-session.test.ts test/player-input-gate.test.ts test/gallery-music-playback.test.ts test/audio-assets.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@surdet/core": "0.1.0",
    "@surdet/host": "0.1.0",
    "@surdet/renderer": "0.1.0"
  },
  "devDependencies": {
    "vite": "^6.3.5"
  }
}
