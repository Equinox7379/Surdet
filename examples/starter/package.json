{
  "name": "surdet-starter",
  "private": true,
  "version": "0.1.0",
  "description": "Surdet 示例游戏：解释器 + 渲染层 + 程序化占位素材",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run --passWithNoTests",
    "lint": "node ../../packages/cli/dist/index.js lint",
    "simulate": "node ../../packages/cli/dist/index.js simulate --assume battleWon=true",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@surdet/core": "0.1.0",
    "@surdet/host": "0.1.0",
    "@surdet/renderer": "0.1.0"
  },
  "devDependencies": {
    "vite": "^6.3.5"
  }
}
