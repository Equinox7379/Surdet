{
  "name": "@surdet/cli",
  "version": "0.1.0",
  "description": "Surdet CLI: create, lint, build and pack galgame projects",
  "type": "module",
  "bin": {
    "surdet": "./dist/index.js",
    "surdet-agent-port": "./dist/agent-port/main.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run --passWithNoTests --exclude \"e2e/artifacts/**\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/core": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@surdet/authoring": "0.1.0",
    "@surdet/core": "0.1.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0"
  }
}
