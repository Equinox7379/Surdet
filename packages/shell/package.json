{
  "name": "@surdet/shell",
  "version": "0.1.0",
  "description": "Surdet Electron shell: main process, window, packaging",
  "type": "module",
  "main": "./dist/main.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-preload.mjs",
    "start": "electron .",
    "pack": "npm run build && node prepare-pack.mjs && node scripts/verify-pack.mjs --preflight && electron-builder --win && node scripts/verify-pack.mjs --artifact",
    "e2e": "node e2e/game.e2e.mjs",
    "e2e:player-experience": "node e2e/player-experience-wave-2.e2e.mjs",
    "e2e:player-experience:wave4": "node e2e/player-experience-wave-4.e2e.mjs",
    "e2e:player-experience:wave5a": "node e2e/player-experience-wave-5a-rollback-black-screen.e2e.mjs",
    "e2e:player-experience:wave5c": "node e2e/player-experience-wave-5c-rollback-restore-atomicity.e2e.mjs",
    "e2e:player-shell-wave-3": "node e2e/player-shell-wave-3.e2e.mjs",
    "e2e:renderer-v2": "node e2e/renderer-v2-acceptance.e2e.mjs",
    "e2e:renderer-baseline": "node e2e/renderer-baseline.e2e.mjs",
    "e2e:renderer-baseline:v3": "node e2e/renderer-baseline-v3-ab.e2e.mjs",
    "benchmark:save": "node scripts/benchmark-save-store.mjs",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "electron": "43.2.0",
    "electron-builder": "^26.15.3",
    "playwright": "^1.49.0"
  },
  "dependencies": {
    "@surdet/core": "0.1.0",
    "@surdet/host": "0.1.0"
  }
}
