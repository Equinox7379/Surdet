{
  "name": "surdet-editor",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "description": "Surdet 可视化剧本编辑器：场景块编辑 + 实时校验 + 项目读写",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:project": "node scripts/dev-project.mjs",
    "build": "vite build",
    "desktop:build": "node scripts/build-desktop.mjs",
    "desktop": "electron desktop-dist",
    "desktop:pack": "npm run desktop:build && electron-builder --win --dir --config desktop/electron-builder.json",
    "desktop:test": "node e2e/desktop.e2e.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p desktop/tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@fontsource-variable/noto-serif-sc": "^5.3.0",
    "@surdet/authoring": "0.1.0",
    "@surdet/core": "0.1.0",
    "@surdet/host": "0.1.0",
    "@surdet/player": "0.1.0",
    "@surdet/renderer": "0.1.0",
    "es-module-lexer": "^1.7.0"
  },
  "devDependencies": {
    "vite": "^6.3.5"
  }
}
