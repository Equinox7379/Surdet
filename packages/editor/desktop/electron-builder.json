{
  "appId": "com.surdet.editor",
  "productName": "Surdet Editor",
  "directories": { "app": "desktop-dist", "output": "release/editor" },
  "files": ["**/*", "!**/*.map", "!node_modules/**", "!templates/**", "!game-runtime/**"],
  "extraResources": [{ "from": "desktop-dist/templates", "to": "templates" }, { "from": "desktop-dist/game-runtime", "to": "game-runtime" }],
  "electronVersion": "43.2.0",
  "electronDist": "../../node_modules/electron/dist",
  "npmRebuild": false,
  "win": { "target": [{ "target": "dir", "arch": ["x64"] }], "signAndEditExecutable": false }
}
